# Deployment configuration for src/client_settings.js.
#
# Copy this file to .env and edit the values for your vehicle/deployment.
# Empty values fall back to the defaults documented in client_settings.js.dist.
# This file is read at build time (npm run build / npm start) - changing it
# requires a rebuild to take effect.

# Set whether the server is using http/https.
# Default is http (false).
SEALOG_SERVER_TLS=false

# Set the server hostname.
# Leave empty to default to the same hostname as the client URL.
SEALOG_SERVER_HOSTNAME=

# Set the server port number.
SEALOG_SERVER_PORT=8100

# URL Root path to the client.
# This MUST match where the client is being hosted by the webserver.
# Change this if not hosting the client at the webserver's document root
# i.e. /sealog/
SEALOG_ROOT_PATH=/

# Where the images are hosted on the webserver.
SEALOG_IMAGE_PATH=/files/images

# Optional reCaptcha bot abuse protection site key. Leave empty to disable.
SEALOG_RECAPTCHA_SITE_KEY=

# Text shown on the login page to the right of the login form.
SEALOG_LOGIN_SCREEN_TXT="Sealog provides the Oceanographic Research community with an open-source tool for recording, reviewing, and exporting in-situ scientific and operational observations."

# Optional image file shown on login page, under SEALOG_LOGIN_SCREEN_TXT.
# Must end in .jpg/.jpeg/.png and live in ./src/assets/images. Leave empty
# to disable.
SEALOG_LOGIN_IMAGE=

# Text shown on the main page above the cruise list.
SEALOG_MAIN_SCREEN_HEADER="Welcome to Sealog"

# Text shown on the main page below SEALOG_MAIN_SCREEN_HEADER and above the
# cruise list.
SEALOG_MAIN_SCREEN_TXT="Please select a cruise from the list below. Selecting a cruise will open the cruise information panel. At the bottom of the cruise information panel there will be links for selecting a lowering. Selecting a lowering will open the lowering information panel. At the bottom of the lowering information panel there will be links proceeding to the lowering replay section, the lowering map section and the lowering gallery section of Sealog. If at any time you wish to return to this page please click the \"Review Cruises/Lowerings\" text in upper navigation bar."

# Default vessel used when creating new cruises.
SEALOG_DEFAULT_VESSEL="R/V Discovery"

# Add cruise-level and lowering-level authentication.
# This needs to match the 'useAccessControl' setting on the sealog-server.
SEALOG_USE_ACCESS_CONTROL=false

# Remove ability to add new events. Set to true for read-only instances of
# Sealog.
SEALOG_DISABLE_EVENT_LOGGING=false

# Optional placeholder text displayed in the CruiseID textfield, e.g.
# OXR20210101. Leave empty to disable.
SEALOG_CRUISE_ID_PLACEHOLDER=

# Optional regular expression (source only, no slashes/flags) used to
# verify a cruise ID. Non-compliant cruise IDs are still allowed but a
# warning message is shown. Leave empty to disable.
# i.e. ^OXR20[0-9]{2}[0-1][0-9][0-3][0-9]$
SEALOG_CRUISE_ID_REGEX=

# Optional customization for cruise nomenclature, as a comma-separated
# "singular,plural" pair, lowercase (capitalized in the client as needed).
# Leave empty to default to "cruise,cruises".
SEALOG_CUSTOM_CRUISE_NAME=

# Optional placeholder text displayed in the LoweringID textfield, e.g.
# CHR0001. Leave empty to disable.
SEALOG_LOWERING_ID_PLACEHOLDER=

# Optional regular expression (source only, no slashes/flags) used to
# verify a lowering ID. Non-compliant lowering IDs are still allowed but a
# warning message is shown. Leave empty to disable.
# i.e. ^CHR[0-9]{4}$
SEALOG_LOWERING_ID_REGEX=

# Optional customization for lowering nomenclature, as a comma-separated
# "singular,plural" pair, lowercase (capitalized in the client as needed).
# Leave empty to default to "lowering,lowerings".
SEALOG_CUSTOM_LOWERING_NAME=

# Comma-separated list of auxdata datasources that should be interpreted as
# vehicle position, in order of importance.
SEALOG_POSITION_DATASOURCES=vehicleRealtimeNavData

# Optional comma-separated list of auxdata datasources that should NOT be
# displayed in the event history, lowering replay or lowering map. Leave
# empty to disable.
SEALOG_EXCLUDE_AUX_DATA_SOURCES=

# Comma-separated list of auxdata datasources that should be interpreted as
# imagery and formatted as such in the event history, lowering replay and
# lowering gallery.
SEALOG_IMAGES_AUX_DATA_SOURCES=eventFileAttachments,framegrabber

# Optional comma-separated list defining how to order auxdata datasources
# in the event history and lowering replay. Leave empty to disable.
SEALOG_AUX_DATA_SORT_ORDER=eventFileAttachments,vehicleRealtimeNavData

# Optional comma-separated list defining how to order event template
# categories, e.g. science,problem,vehicle. Leave empty to disable.
SEALOG_CATEGORY_SORT_ORDER=

# Default button color (Bootstrap variant name) used for event templates
# that do not specify their own event_button_color.
SEALOG_DEFAULT_EVENT_TEMPLATE_BUTTON_COLOR=primary
